#!/usr/bin/env bash
set -euo pipefail

VERSION="1.1"
RAW_INSTALLER="https://imemix.github.io/eminstaller.py"


echo "==========================================="
echo "        EMInstaller v${VERSION}"
echo "==========================================="

if [ "$(id -u)" -ne 0 ]; then
    echo "[ERROR] Please run with sudo."
    exit 1
fi

echo "[*] Installing and Updating dependencies..."
pacman -Sy --noconfirm python git curl archinstall >/dev/null

TMP_SCRIPT="/tmp/eminstaller.py"

echo "[*] Downloading installer..."
# Try local copy first (for testing), then fall back to GitHub
if [ -f "/eminstaller.py" ]; then
    cp /eminstaller.py "$TMP_SCRIPT"
else
    curl -sL "$RAW_INSTALLER" -o "$TMP_SCRIPT"
fi

echo "[*] Launching EMInstaller..."

python3 "$TMP_SCRIPT"
